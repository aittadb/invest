APP_BASE_URL=https://invest.example.com
OWNER_EMAIL=owner@example.com
# Optional development-only public presentation bootstrap. Persistent campaign
# state must come from the hosted AittaDB runtime.
CAMPAIGN_CONFIG_JSON=replace-with-validated-public-campaign-json

# Hosted application persistence. Configure every required value together. The
# transport origin is optional and backend-only; omit it when the logical issuer
# is directly reachable. Keep the client secret and mutation key in hosted
# secret storage. The service client must have no browser origin or redirect.
AITTADB_STORAGE_ISSUER=https://storage.example.com
AITTADB_STORAGE_TRANSPORT_ORIGIN=https://storage-runtime.example.com
AITTADB_STORAGE_ENTRY_HREF=https://storage.example.com/replace-with-discovery-resource
AITTADB_STORAGE_CLIENT_ID=replace-with-dedicated-service-client-id
AITTADB_STORAGE_CLIENT_SECRET=replace-in-hosted-secrets
AITTADB_STORAGE_SCOPES=storage.read storage.write storage.delete
BROWSER_MUTATION_SESSION_KEY=replace-with-base64url-encoded-32-byte-secret
# Exact "true" enables publication only after deployment readiness is proven.
# Missing or "false" blocks publication; any other value disables the runtime.
DEPLOYMENT_PUBLICATION_READY=false

# Optional AittaDB OAuth proof. Configure every required value together; keep
# secret values in hosted secret storage rather than source control. Omit the
# transport origin when backend requests can use the issuer origin directly.
AITTADB_OAUTH_ISSUER=https://storage.example.com
AITTADB_OAUTH_TRANSPORT_ORIGIN=https://storage-runtime.example.com
AITTADB_OAUTH_CLIENT_ID=replace-with-confidential-client-id
AITTADB_OAUTH_CLIENT_SECRET=replace-in-hosted-secrets
AITTADB_OAUTH_CALLBACK_URI=https://invest.example.com/owner/aittadb-connection/callback
AITTADB_OAUTH_STORAGE_SCOPES=storage.read
AITTADB_OAUTH_TRANSACTION_KEY=replace-with-base64url-encoded-32-byte-secret
AITTADB_OAUTH_CSRF_KEY=replace-with-a-different-base64url-encoded-32-byte-secret
