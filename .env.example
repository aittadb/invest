APP_BASE_URL=https://invest.example.com
OWNER_EMAIL=owner@example.com
CAMPAIGN_CONFIG_JSON=replace-with-validated-public-campaign-json

IDENTITY_ISSUER_URL=https://identity.example.com
IDENTITY_CLIENT_ID=invest-app
IDENTITY_CLIENT_SECRET=replace-in-hosted-secrets

STORAGE_BASE_URL=https://storage.example.com
STORAGE_DATABASE_ID=replace-with-campaign-storage-id
STORAGE_BACKEND_CREDENTIAL=replace-in-hosted-secrets

SESSION_SECRET=replace-in-hosted-secrets

# Optional AittaDB OAuth proof. Configure every required value together; keep
# secret values in hosted secret storage rather than source control. Omit the
# transport origin when backend requests can use the issuer origin directly.
AITTADB_OAUTH_ISSUER=https://storage.example.com
AITTADB_OAUTH_TRANSPORT_ORIGIN=https://storage-runtime.example.com
AITTADB_OAUTH_CLIENT_ID=replace-with-confidential-client-id
AITTADB_OAUTH_CLIENT_SECRET=replace-in-hosted-secrets
AITTADB_OAUTH_CALLBACK_URI=https://invest.example.com/owner/aittadb-connection/callback
AITTADB_OAUTH_STORAGE_SCOPES=storage.read
AITTADB_OAUTH_TRANSACTION_KEY=replace-with-base64url-encoded-32-byte-secret
AITTADB_OAUTH_CSRF_KEY=replace-with-a-different-base64url-encoded-32-byte-secret
