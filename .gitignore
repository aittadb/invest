# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/.dev.vars*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/migration-inventories/

# ChatGPT Sites instance bindings are local deployment state.
/.openai/hosting.json
!/.openai/hosting.example.json
